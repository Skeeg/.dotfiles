#!/usr/bin/env bash
if [ $# -lt 2 ]; then
  echo "Error: get-1password-field requires at least 2 arguments: entry_name, field [account] [vault]" >&2
  exit 1
fi

entry_name="$1"
field="$2"
op_account="${3:-pluralsight.1password.com}"
op_vault="${4:-Shared-Ops}"

op item get --account "$op_account" "$entry_name" --fields label="$field" --vault "$op_vault" --reveal
