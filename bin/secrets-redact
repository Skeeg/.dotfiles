#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""
secrets-redact — scan for secrets with gitleaks (Docker) and optionally redact them

Ported 2026-09-27 from claude-scratch/python/secrets-redaction.py (which superseded
transcript_scan.sh + transcript_redact.py). Stdlib only: without uv, run it as
`python3 ~/bin/secrets-redact …`.

Ruleset: the canonical base, ~/.config/gitleaks/gitleaks.toml (dotfiles), by default.
--config points at another file, e.g. a repo's .gitleaks.toml that extends the base
via [extend] path = "/etc/gitleaks/base.toml". The base is always mounted at that
path, so child configs resolve. Override the base with GITLEAKS_BASE.

Usage:
  secrets-redact <PATH> [MODE FLAG] [MODIFIER]

PATH may be a file or directory. Findings are deduplicated by
(file, line, secret_value); when both a default gitleaks rule and a
-jsonl variant fire on the same secret, the non-jsonl rule ID is kept.

Flags and valid combinations:
  (no flags)              dry-run: report findings without modifying files
  --show-count            dry-run + per-rule count breakdown  [exclusive]
  --clean                 redact secrets in-place
  --clean --no-backup     redact in-place, skip .bak files    [paired]
  --scan-only             print raw gitleaks JSON and exit    [exclusive]
  --history               scan git history (gitleaks git) instead of files on
                          disk; report-only. Combines with --show-count or
                          --scan-only. PATH is any directory in the repo; the
                          whole repo is scanned.
  --log-opts OPTS         git log options for --history, e.g. "-1 <sha>" or
                          "--all" or "main~50..main"

Default (dir) mode only sees the working tree: a secret that was committed and
later removed is invisible to it. Use --history for that.

Incompatible combinations (rejected at startup):
  --scan-only + --clean       scan-only produces no redactions
  --scan-only + --no-backup   scan-only does not write files
  --scan-only + --show-count  scan-only emits raw JSON; no summary
  --show-count + --clean      use the dry-run summary before deciding to clean
  --no-backup without --clean no-backup has no effect without --clean
  --history + --clean         history can't be redacted in place (rewrite it
                              with git filter-repo, and rotate the secret)
  --log-opts without --history

Examples:
  # Dry-run report
  secrets-redact ~/.claude/projects

  # Dry-run with per-rule breakdown
  secrets-redact ~/.claude/projects --show-count

  # Redact a single file in-place
  secrets-redact ~/.claude/projects/foo/bar.jsonl --clean

  # Emit raw findings JSON for external tooling
  secrets-redact ~/.claude/projects --scan-only

  # Scan every commit reachable from HEAD, or one commit
  secrets-redact ~/repo/foo --history
  secrets-redact ~/repo/foo --history --log-opts "-1 <sha>"
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
from collections import defaultdict

IMAGE = "ghcr.io/gitleaks/gitleaks:latest"
BASE_CONFIG = os.path.expanduser(os.environ.get("GITLEAKS_BASE", "~/.config/gitleaks/gitleaks.toml"))

USAGE = """\
usage: secrets-redact PATH [FLAG] [--config FILE]

Scan PATH (file or directory) for secrets using gitleaks and optionally redact them.

--show-count is the default: running without flags produces a dry-run report with
a per-rule count breakdown. You do not need to pass --show-count explicitly.

Valid combinations:
  PATH                       dry-run report + count  (default)
  PATH --show-count          same as default (explicit)
  PATH --clean               redact secrets in-place
  PATH --clean --no-backup   redact in-place, skip .bak files
  PATH --scan-only           print raw gitleaks findings JSON
  PATH --history             report secrets anywhere in git history (not just on disk)
  PATH --history --log-opts "-1 <sha>"   limit history to git log options

Incompatible:
  --scan-only + any other flag except --history/--log-opts
  --show-count + --clean        (run --show-count first, then --clean)
  --no-backup without --clean
  --history + --clean           (history is report-only)
  --log-opts without --history
"""


def print_usage() -> None:
  print(USAGE, end="")


def parse_args() -> argparse.Namespace:
  p = argparse.ArgumentParser(
    description="Scan and redact secrets using gitleaks",
    epilog=(
      "Valid combinations: (none) | --show-count | --clean | --clean --no-backup | --scan-only. "
      "See module docstring for full incompatibility rules."
    ),
  )
  p.add_argument("path", metavar="PATH", help="file or directory to scan")
  p.add_argument("--config", metavar="FILE", default=None,
    help="gitleaks config (default: the canonical base; a repo .gitleaks.toml that extends it also works)")
  p.add_argument("--clean", action="store_true", help="redact secrets in-place (default: dry-run report)")
  p.add_argument("--scan-only", action="store_true", help="print raw gitleaks findings JSON and exit [exclusive]")
  p.add_argument("--no-backup", action="store_true", help="skip creating .bak files; requires --clean [paired]")
  p.add_argument("--show-count", action="store_const", const=True, default=None,
    help="print per-rule finding count; dry-run only [exclusive, default for dry-run]")
  p.add_argument("--history", action="store_true",
    help="scan git history (gitleaks git) instead of files on disk; report-only")
  p.add_argument("--log-opts", metavar="OPTS", default=None,
    help='git log options for --history, e.g. "-1 <sha>" or "--all"')
  return p.parse_args()


def validate_args(args: argparse.Namespace) -> None:
  if args.scan_only:
    # args.show_count is None (not passed) or True (explicitly passed); either conflicts
    conflicts = [f for f, v in [("--clean", args.clean), ("--no-backup", args.no_backup), ("--show-count", args.show_count)] if v]
    if conflicts:
      sys.exit(f"ERROR: --scan-only is exclusive and cannot be combined with: {', '.join(conflicts)}")

  if args.no_backup and not args.clean:
    sys.exit("ERROR: --no-backup requires --clean")

  if args.show_count is True and args.clean:
    # only reject when --show-count was explicitly passed alongside --clean
    sys.exit("ERROR: --show-count and --clean are mutually exclusive; run without --clean first, then --clean")

  if args.history and args.clean:
    sys.exit("ERROR: --history is report-only; history can't be redacted in place "
             "(rewrite it with git filter-repo, and rotate the secret)")

  if args.log_opts is not None and not args.history:
    sys.exit("ERROR: --log-opts requires --history")


def git_toplevel(path: str) -> str:
  """Repo root for --history. The whole repo is mounted so gitleaks can read .git."""
  start = path if os.path.isdir(path) else os.path.dirname(path)
  res = subprocess.run(["git", "-C", start, "rev-parse", "--show-toplevel", "--git-common-dir"],
    capture_output=True, text=True)
  if res.returncode != 0:
    sys.exit(f"ERROR: --history needs a git repository: {path}")
  top, common = res.stdout.splitlines()
  common = os.path.realpath(os.path.join(start, common))
  # a linked worktree keeps its object store outside the mount; gitleaks can't follow it
  if not common.startswith(os.path.realpath(top) + os.sep):
    sys.exit(f"ERROR: --history can't scan a linked worktree (git dir {common}); "
             "run it from the main checkout")
  return top


def run_scan(scan_path_abs: str, is_file: bool, config_file: str,
             history: bool = False, log_opts: str | None = None) -> list[dict]:
  for label, path in (("config", config_file), ("base ruleset", BASE_CONFIG)):
    if not os.path.exists(path):
      print(f"ERROR: {label} not found: {path}", file=sys.stderr)
      sys.exit(1)

  if history:
    vol_args = ["-v", f"{scan_path_abs}:/scan:ro"]
    mode_args = ["git", "/scan", *([f"--log-opts={log_opts}"] if log_opts else [])]
  elif is_file:
    basename = os.path.basename(scan_path_abs)
    vol_args = ["-v", f"{scan_path_abs}:/scan/{basename}:ro"]
  else:
    vol_args = ["-v", f"{scan_path_abs}:/scan:ro"]
  if not history:
    mode_args = ["dir", "/scan"]

  with tempfile.TemporaryDirectory() as report_dir:
    cmd = [
      "docker", "run", "--rm",
      *vol_args,
      "-v", f"{config_file}:/config.toml:ro",
      "-v", f"{BASE_CONFIG}:/etc/gitleaks/base.toml:ro",
      "-v", f"{report_dir}:/report",
      IMAGE, *mode_args,
      "--config", "/config.toml",
      "--report-format", "json",
      "--report-path", "/report/findings.json",
      "--exit-code", "0",
    ]
    subprocess.run(cmd, check=True, stderr=subprocess.DEVNULL)

    findings_path = os.path.join(report_dir, "findings.json")
    if os.path.exists(findings_path):
      with open(findings_path) as f:
        return json.load(f)
  return []


def remap_path(container_path: str, scan_path: str, is_file: bool) -> str:
  """Map /scan/... container paths back to the host filesystem."""
  if is_file:
    basename = os.path.basename(scan_path)
    if container_path in (f"/scan/{basename}", "/scan"):
      return scan_path
    return container_path
  if container_path.startswith("/scan/"):
    return os.path.join(scan_path, container_path[len("/scan/"):])
  if container_path == "/scan":
    return scan_path
  return container_path


def deduplicate(findings: list[dict], scan_path: str, is_file: bool) -> list[dict]:
  seen: dict[tuple, dict] = {}
  for f in findings:
    secret = f.get("Secret") or f.get("Match", "")
    if not secret:
      continue
    host_file = remap_path(f["File"], scan_path, is_file)
    # git mode reports repo-relative paths; the same secret in two commits is two leaks
    if not host_file.startswith("/"):
      host_file = os.path.join(scan_path, host_file)
    key = (host_file, f["StartLine"], secret, f.get("Commit", ""))
    if key not in seen:
      seen[key] = {**f, "_host_file": host_file, "_secret": secret}
    else:
      existing_id = seen[key]["RuleID"]
      this_id = f["RuleID"]
      if existing_id.endswith("-jsonl") and not this_id.endswith("-jsonl"):
        seen[key] = {**f, "_host_file": host_file, "_secret": secret}
  return list(seen.values())


def redact_file(host_file: str, file_findings: list[dict], clean: bool, no_backup: bool) -> int:
  try:
    with open(host_file, encoding="utf-8", errors="replace") as fh:
      lines = fh.readlines()
  except OSError as e:
    print(f"  ERROR reading {host_file}: {e}", file=sys.stderr)
    return 0

  by_line: dict[int, list[dict]] = defaultdict(list)
  for finding in file_findings:
    by_line[finding["StartLine"]].append(finding)

  file_modified = False
  count = 0

  for line_no in sorted(by_line):
    if line_no < 1 or line_no > len(lines):
      print(f"  WARN: line {line_no} out of range in {host_file}", file=sys.stderr)
      continue

    for finding in by_line[line_no]:
      secret = finding["_secret"]
      rule_id = finding["RuleID"]
      replacement = f"[REDACTED:{rule_id}]"

      # For multi-line gitleaks matches (e.g. Bruno YAML name/value pairs), the
      # captured secretGroup value may be on EndLine rather than StartLine.
      # Probe forward from StartLine through EndLine to find the actual target.
      target_no = line_no
      if secret not in lines[target_no - 1]:
        end_line = finding.get("EndLine", line_no)
        for probe in range(line_no + 1, end_line + 1):
          if 1 <= probe <= len(lines) and secret in lines[probe - 1]:
            target_no = probe
            break
        else:
          print(
            f"  SKIP [{rule_id}] {os.path.basename(host_file)}:{line_no} "
            f"— secret not found on line (already redacted?)",
            file=sys.stderr,
          )
          continue

      suffix = "(dry run)" if not clean else ""
      print(f"  [{rule_id}] {host_file}:{target_no} — {len(secret)} chars {suffix}")
      count += 1

      if clean:
        lines[target_no - 1] = lines[target_no - 1].replace(secret, replacement)
        file_modified = True

  if clean and file_modified:
    if not no_backup:
      backup = host_file + ".bak"
      if not os.path.exists(backup):
        shutil.copy2(host_file, backup)

    dir_name = os.path.dirname(os.path.abspath(host_file))
    fd, tmp_path = tempfile.mkstemp(dir=dir_name)
    try:
      with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.writelines(lines)
      os.replace(tmp_path, host_file)
    except Exception:
      try:
        os.unlink(tmp_path)
      except OSError:
        pass
      raise

  return count


def main() -> None:
  if len(sys.argv) == 1:
    print_usage()
    sys.exit(0)

  args = parse_args()
  validate_args(args)

  # --show-count defaults to True for dry-run; False when --clean or --scan-only is active
  show_count = args.show_count if args.show_count is not None else (not args.clean and not args.scan_only)

  scan_path = os.path.realpath(os.path.expanduser(args.path))

  if not os.path.exists(scan_path):
    print(f"ERROR: path does not exist: {scan_path}", file=sys.stderr)
    sys.exit(1)

  if args.history:
    scan_path = git_toplevel(scan_path)

  is_file = os.path.isfile(scan_path)
  config_file = os.path.realpath(os.path.expanduser(args.config)) if args.config else BASE_CONFIG
  findings = run_scan(scan_path, is_file, config_file, args.history, args.log_opts)

  if args.scan_only:
    print(json.dumps(findings, indent=2))
    return

  if not findings:
    print("No findings.")
    return

  unique = deduplicate(findings, scan_path, is_file)

  by_file: dict[str, list[dict]] = defaultdict(list)
  for f in unique:
    by_file[f["_host_file"]].append(f)

  total = 0
  rule_counts: dict[str, int] = defaultdict(int)

  for host_file in sorted(by_file):
    print(f"\n{host_file}")
    file_findings = by_file[host_file]
    if args.history:
      # report-only: the working-tree file may no longer hold the secret
      for f in sorted(file_findings, key=lambda f: (f["Date"], f["StartLine"])):
        print(f"  [{f['RuleID']}] {host_file}:{f['StartLine']} @ {f['Commit'][:8]} "
              f"{f['Date'][:10]} — {len(f['_secret'])} chars")
      total += len(file_findings)
    else:
      total += redact_file(host_file, file_findings, args.clean, args.no_backup)
    for f in file_findings:
      rule_counts[f["RuleID"]] += 1

  if args.history:
    mode = "findings in git history (report-only)"
  else:
    mode = "redacted" if args.clean else "findings (dry run — pass --clean to redact)"
  print(f"\n{total} {mode} across {len(by_file)} file(s)")

  if show_count:
    print("\nBy rule:")
    for rule, count in sorted(rule_counts.items(), key=lambda x: -x[1]):
      print(f"  {rule}: {count}")


if __name__ == "__main__":
  main()
