#!/usr/bin/env bash
# shellcheck disable=SC2154

_git_default_branch() {
  local remote
  if git remote | grep -qx origin; then
    remote="origin"
  else
    remote="$(git remote)"
    if [ "$(printf '%s\n' "$remote" | wc -l)" -ne 1 ]; then
      echo "gittyup: cannot determine default branch — no 'origin' remote and repo has $(git remote | wc -l) remotes" >&2
      return 1
    fi
  fi
  git remote show "$remote" | grep "HEAD branch" | sed 's/.*: //'
}

_git_switch_default() {
  local default_branch
  default_branch="$(_git_default_branch)" || return 1
  [ "$(git branch --show-current)" = "$default_branch" ] && return 0
  git switch "$default_branch"
}

_git_is_repo() {
  git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

_git_stash_if_needed() {
  if [ -n "$(git status --porcelain)" ]; then
    git stash
    return 0
  fi
  return 1
}

_set_mode() {
  if [ "$_MODE" != "default" ]; then
    echo "gittyup: only one of --auto-switch-on-missing, --switch-pull, --stash-switch-pull, --stash-switch-pull-pop may be specified." >&2
    exit 1
  fi
  _MODE="$1"
}

unset _REPO_PATH _FAIL_PULL
_MODE="default"

if [ -n "${REPOPATH+x}" ]; then _REPO_PATH="$REPOPATH"; fi

while [[ $# -gt 0 ]]; do
  key="$1"
  case $key in
    --repo-path)
      _REPO_PATH="$2"
      shift 2
      ;;
    --auto-switch-on-missing)
      _set_mode "auto-switch"
      shift
      ;;
    --switch-pull)
      _set_mode "switch-pull"
      shift
      ;;
    --stash-switch-pull)
      _set_mode "stash-switch-pull"
      shift
      ;;
    --stash-switch-pull-pop)
      _set_mode "stash-switch-pull-pop"
      shift
      ;;
    *)
      shift
      ;;
  esac
done

if [ -z "$_REPO_PATH" ]; then
  echo "gittyup: REPOPATH is not set. Configure it or pass --repo-path." >&2
  exit 1
fi

for folder in "$_REPO_PATH"/*/; do
  printf "Syncing %s\n" "$folder"

  if ! _git_is_repo "$folder"; then
    echo "gittyup: $folder is not a git repository, skipping"
    continue
  fi

  case "$_MODE" in
    switch-pull)
      (cd "$folder" && _git_switch_default && git pull)
      ;;
    stash-switch-pull)
      (
        cd "$folder" || exit 1
        _git_stash_if_needed
        _git_switch_default && git pull
      )
      ;;
    stash-switch-pull-pop)
      (
        cd "$folder" || exit 1
        _stashed=0
        _git_stash_if_needed && _stashed=1
        _git_switch_default && git pull
        [ "$_stashed" -eq 1 ] && git stash pop
      )
      ;;
    auto-switch)
      git -C "$folder" pull
      _FAIL_PULL=$?
      [[ $_FAIL_PULL == 1 ]] && {
        [[ $(git -C "$folder" pull 2> >(grep -c -e 'no such ref was fetched')) == 1 ]] && {
          (cd "$folder" && _git_switch_default && git pull)
        }
      }
      ;;
    *)
      git -C "$folder" pull
      ;;
  esac
done

unset _REPO_PATH _MODE _FAIL_PULL
